{
  "name": "@m5nita/api",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed-stats": "tsx --env-file=.env src/scripts/seedStatsDemo.ts",
    "db:seed-knockout": "tsx --env-file=.env src/scripts/seedKnockoutDemo.ts",
    "db:backfill-encrypt-pix-keys": "tsx --env-file=.env src/scripts/backfillEncryptPixKeys.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@m5nita/shared": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.56.0",
    "@sentry/profiling-node": "^10.56.0",
    "better-auth": "1.6.14",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.43.0",
    "hono": "^4.12.23",
    "hono-rate-limiter": "^0.5.3",
    "postgres": "^3.4.9",
    "resend": "^6.12.4",
    "satori": "^0.26.0",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.14.6",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
