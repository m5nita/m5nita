VITE_API_URL=http://localhost:3001

# Cloudflare Turnstile site key (public; use test key 1x00000000000000000000AA in dev/test)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Web Push public VAPID key (public; same value as the API's VAPID_PUBLIC_KEY).
# Leave empty to disable the push opt-in UI. Generate: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Sentry (leave VITE_SENTRY_DSN empty to disable runtime reporting)
VITE_SENTRY_DSN=

# Source-map upload (build time only; required for readable stack traces)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Announcement banner (optional, global). Leave VITE_BANNER_ENABLED unset/false to hide.
# Build-time config: changing these requires a web rebuild + redeploy.
VITE_BANNER_ENABLED=false
VITE_BANNER_MESSAGE=
VITE_BANNER_LINK=
# Optional campaign id; bump to re-show the banner to users who dismissed a previous one.
VITE_BANNER_ID=
# Optional schedule (ISO 8601, include the timezone offset, e.g. 2026-07-10T00:00:00-03:00).
# The banner only shows within [START, END]; it appears/disappears automatically at these
# instants in the user's browser — no new deploy needed. Leave empty for no limit.
VITE_BANNER_START=
VITE_BANNER_END=
